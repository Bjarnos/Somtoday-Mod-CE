# Most things in this .gitignore aren't needed, but are here
# to prevent rookies committing them :)

# Build output & packages
dist/
build/
builds/
out/
package/
*.zip
*.crx
*.xpi
*.apk

# Dependencies
node_modules/
vendor/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment & local config
.env
.env.local
.env.*.local

# IDE & Editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
