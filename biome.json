{
    "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!!**/dist",
            "!!**/node_modules",
            "!!src/scripts/chart.js",
            "!!src/scripts/fireworks.js",
            "!!src/images",
            "!!src/fonts",
            "!!src/sounds",
            "!!src/data"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "a11y": {
                "recommended": false
            },
            "complexity": {
                "noImportantStyles": "off"
            },
            "suspicious": {
                "noDoubleEquals": "off",
                "noExplicitAny": "off"
            },
            "correctness": {
                "noUnusedVariables": "off"
            },
            "style": {
                "noDescendingSpecificity": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
